# ==============================================================================
# SehatKu HMS Monorepo .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Secrets & Credentials (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
*.keystore
key.properties
service-account*.json
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# 2. Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# JetBrains / IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code
.vscode/
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace

# ------------------------------------------------------------------------------
# 3. Node.js & NestJS Backend (sehatku_hms_backend)
# ------------------------------------------------------------------------------
**/node_modules/
**/dist/
**/build/
**/.npm
**/.yarn
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Prisma SQLite local (if used)
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# ------------------------------------------------------------------------------
# 4. Database & Container Volumes
# ------------------------------------------------------------------------------
**/postgres_data/
**/redis_data/

# ------------------------------------------------------------------------------
# 5. Flutter & Dart (sehatku_hms_mobile)
# ------------------------------------------------------------------------------
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/coverage/
**/doc/api/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Android Build & Gradle
**/android/.gradle/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/app/build/
**/android/.cxx/

# iOS Build & CocoaPods
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/ServiceDefinitions.json

# macOS Build
**/macos/Pods/
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift

# Temporary / Cache
*.swp
*.bak
*.tmp
*.temp
.history
